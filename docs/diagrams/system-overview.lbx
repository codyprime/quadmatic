    "version": 1,
    "source": "title: \"quadmatic — High-Level System Architecture\"\ndirection: right\nstyle:\n  theme: gruvbox-dark\n  look: clean\n  font: sans\n  route: elbow\n  spacing: normal\n  compactness: 0.45\n\nnodes:\n  # External inputs \u0026 control plane\n  - id: gitrepo\n    label: \"Signed Git Repo\\nusers.toml · hosts/\u003ch\u003e.toml\\ncomponents/ · secrets/*.age\"\n    color: orange\n    rank: 0\n    group: external\n  - id: prom\n    label: \"VictoriaMetrics /\\nPrometheus\"\n    shape: ellipse\n    color: pink\n    rank: 0\n    group: external\n  - id: butane\n    label: \"Butane / Ignition\\n(First Boot Only)\\n/var saved · sysctls · VRF rules\\nkeys · /etc/quadmatic/*\"\n    color: yellow\n    fill: hachure\n    rank: 0\n    group: external\n\n  # Host config \u0026 persistent state\n  - id: hostcfg\n    label: \"/etc/quadmatic/\\nconfig.toml · deploy_key\\nknown_hosts · allowed-signers\\nage.key (0600)\"\n    shape: rect\n    color: yellow\n    fill: hachure\n    rank: 1\n    group: host\n  - id: agent\n    label: \"quadmatic (root)\\nstatic Go binary\\ndaemon · apply · validate\\n/metrics (bound mgmt IP)\"\n    color: blue\n    rank: 2\n    group: host\n  - id: state\n    label: \"/var/lib/quadmatic/\\nstate.json · state.json.lock\\nrepo/ (bare Git cache)\"\n    shape: rect\n    color: indigo\n    fill: hachure\n    rank: 2\n    group: host\n\n  # Reconciled host subsystems\n  - id: users\n    label: \"Linux Accounts\\n/etc/passwd · /etc/subuid\\n/var/home/\u003cuser\u003e (0700)\\nloginctl enable-linger\"\n    color: green\n    rank: 3\n    group: subsystems\n  - id: nm\n    label: \"NetworkManager + ip\\nqm-vlan\u003cV\u003e · qmv-\u003cuid\u003e\\nqm-\u003cuid\u003e (MAC + DHCP)\\nl3mdev before local\"\n    color: cyan\n    rank: 3\n    group: subsystems\n  - id: quadletdirs\n    label: \"Quadlet Units (root-owned)\\n/etc/containers/systemd/\\nusers/\u003cuid\u003e/ (rootless)\\n+ rootful exceptions\"\n    shape: rect\n    color: teal\n    rank: 3\n    group: subsystems\n  - id: secstore\n    label: \"Podman Secrets\\nin-memory age decrypt\\nstdin -\u003e podman secret\"\n    color: red\n    rank: 3\n    group: subsystems\n\n  # Running workloads\n  - id: rootless\n    label: \"Rootless Services\\nper-UID userns + pasta\\nsystemd --user units\\n(default)\"\n    color: green\n    rank: 4\n    group: workloads\n  - id: rootful\n    label: \"Rootful Exceptions\\nUSB / L2 mDNS\\nsystem systemd units\"\n    color: orange\n    rank: 4\n    group: workloads\n  - id: autoupdate\n    label: \"podman-auto-update\\n.timer\\n(image updates only)\"\n    color: gray\n    stroke: dashed\n    size: s\n    rank: 4\n    group: workloads\n\nedges:\n  - {from: butane, to: hostcfg, label: \"provisions once\", style: dashed}\n  - {from: butane, to: agent, label: \"installs + enables\", style: dashed}\n  - {from: gitrepo, to: agent, label: \"SSH pull + sig/FF verify\"}\n  - {from: hostcfg, to: agent, label: \"config \u0026 keys\"}\n  - {from: prom, to: agent, label: \"GET /metrics\"}\n  - {from: agent, to: state, arrow: both, label: \"flock + atomic state\"}\n  - {from: agent, to: users, label: \"useradd / linger\"}\n  - {from: agent, to: nm, label: \"nmcli / ip rule\"}\n  - {from: agent, to: quadletdirs, label: \"os.Root atomic write\"}\n  - {from: agent, to: secstore, label: \"systemd-run --pipe\"}\n  - {from: users, to: rootless, label: \"UID + /var/home\"}\n  - {from: nm, to: rootless, label: \"pasta -i qm-\u003cuid\u003e\"}\n  - {from: quadletdirs, to: rootless, label: \"user daemon-reload\"}\n  - {from: secstore, to: rootless, label: \"Secret=\"}\n  - {from: quadletdirs, to: rootful, label: \"system daemon-reload\"}\n  - {from: nm, to: rootful, label: \"parent VLAN\", style: dashed}\n  - {from: autoupdate, to: rootless, label: \"registry pull\", style: dashed}\n\ngroups:\n  - {id: external, label: \"Control Plane \u0026 Bootstrap\"}\n  - {id: host, label: \"Fedora CoreOS Host\"}\n  - {id: subsystems, label: \"Host OS Subsystems (Reconciled)\", group: host}\n  - {id: workloads, label: \"Managed Workloads\", group: host}\n"
  },
