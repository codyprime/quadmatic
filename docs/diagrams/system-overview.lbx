  "name": "quadmatic — High-Level System Architecture",
  "diagram": {
    "spec": {
      "title": "quadmatic — High-Level System Architecture",
      "direction": "right",
      "style": {
        "font": "sans",
        "look": "clean",
        "route": "elbow",
        "spacing": "normal",
        "compactness": 0.45,
        "theme": "gruvbox-dark"
      },
      "nodes": [
        {
          "id": "gitrepo",
          "label": "Signed Git Repo\nusers.toml · hosts/\u003ch\u003e.toml\ncomponents/ · secrets/*.age",
          "color": "orange",
          "rank": 0,
          "group": "external"
        },
        {
          "id": "prom",
          "label": "VictoriaMetrics /\nPrometheus",
          "shape": "ellipse",
          "color": "pink",
          "rank": 0,
          "group": "external"
        },
        {
          "id": "butane",
          "label": "Butane / Ignition\n(First Boot Only)\n/var saved · sysctls · VRF rules\nkeys · /etc/quadmatic/*",
          "color": "yellow",
          "fill": "hachure",
          "rank": 0,
          "group": "external"
        },
        {
          "id": "hostcfg",
          "label": "/etc/quadmatic/\nconfig.toml · deploy_key\nknown_hosts · allowed-signers\nage.key (0600)",
          "shape": "rect",
          "color": "yellow",
          "fill": "hachure",
          "rank": 1,
          "group": "host"
        },
        {
          "id": "agent",
          "label": "quadmatic (root)\nstatic Go binary\ndaemon · apply · validate\n/metrics (bound mgmt IP)",
          "color": "blue",
          "rank": 2,
          "group": "host"
        },
        {
          "id": "state",
          "label": "/var/lib/quadmatic/\nstate.json · state.json.lock\nrepo/ (bare Git cache)",
          "shape": "rect",
          "color": "indigo",
          "fill": "hachure",
          "rank": 2,
          "group": "host"
        },
        {
          "id": "users",
          "label": "Linux Accounts\n/etc/passwd · /etc/subuid\n/var/home/\u003cuser\u003e (0700)\nloginctl enable-linger",
          "color": "green",
          "rank": 3,
          "group": "subsystems"
        },
        {
          "id": "nm",
          "label": "NetworkManager + ip\nqm-vlan\u003cV\u003e · qmv-\u003cuid\u003e\nqm-\u003cuid\u003e (MAC + DHCP)\nl3mdev before local",
          "color": "cyan",
          "rank": 3,
          "group": "subsystems"
        },
        {
          "id": "quadletdirs",
          "label": "Quadlet Units (root-owned)\n/etc/containers/systemd/\nusers/\u003cuid\u003e/ (rootless)\n+ rootful exceptions",
          "shape": "rect",
          "color": "teal",
          "rank": 3,
          "group": "subsystems"
        },
        {
          "id": "secstore",
          "label": "Podman Secrets\nin-memory age decrypt\nstdin -\u003e podman secret",
          "color": "red",
          "rank": 3,
          "group": "subsystems"
        },
        {
          "id": "rootless",
          "label": "Rootless Services\nper-UID userns + pasta\nsystemd --user units\n(default)",
          "color": "green",
          "rank": 4,
          "group": "workloads"
        },
        {
          "id": "rootful",
          "label": "Rootful Exceptions\nUSB / L2 mDNS\nsystem systemd units",
          "color": "orange",
          "rank": 4,
          "group": "workloads"
        },
        {
          "id": "autoupdate",
          "label": "podman-auto-update\n.timer\n(image updates only)",
          "color": "gray",
          "stroke": "dashed",
          "size": "s",
          "rank": 4,
          "group": "workloads"
        }
      ],
      "edges": [
        {
          "from": "butane",
          "to": "hostcfg",
          "label": "provisions once",
