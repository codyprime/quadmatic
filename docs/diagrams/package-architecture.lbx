    "version": 1,
    "source": "title: \"quadmatic — Go Package Architecture \u0026 Dependency Graph\"\ndirection: right\nstyle:\n  theme: gruvbox-dark\n  look: clean\n  font: sans\n  route: elbow\n  spacing: normal\n  compactness: 0.5\n\nnodes:\n  - id: cmd\n    label: \"cmd/quadmatic\\nCLI \u0026 composition root\\ndaemon · apply · validate\\nSIGHUP · SIGINT/SIGTERM\"\n    color: orange\n    rank: 0\n\n  - id: apply\n    label: \"internal/apply\\nEngine · 8-stage pipeline\\nflock · os.Root files\\nSystemctl · rollback\"\n    color: blue\n    rank: 1\n    order: 1\n    group: core\n  - id: metrics\n    label: \"internal/metrics\\nPrometheus Registry\\n9 spec metrics\\nbound HTTP /metrics\"\n    color: pink\n    rank: 1\n    order: 2\n    group: core\n  - id: config\n    label: \"internal/config\\n/etc/quadmatic/config.toml\\nstrict TOML · bind IP guard\"\n    color: yellow\n    rank: 2\n    order: 5\n    group: core\n\n  - id: quadlet\n    label: \"internal/quadlet\\nquadlet --dryrun runner\\nunit parser · SourceCandidates\\nSecret= extractor\"\n    color: cyan\n    rank: 2\n    order: 1\n    group: subs\n  - id: netmgr\n    label: \"internal/netmgr\\nnmcli VLAN/VRF/macvlan\\nIPv4/6 unreachable routes\\nl3mdev-before-local · rollback\"\n    color: teal\n    rank: 2\n    order: 2\n    group: subs\n  - id: secrets\n    label: \"internal/secrets\\npure-Go age + agessh\\nin-memory decrypt\\nstdin podman secret\"\n    color: red\n    rank: 2\n    order: 3\n    group: subs\n  - id: gitops\n    label: \"internal/gitops\\nSSH fetch · verify-commit\\nFF guard · safe tar export\\ndry-run alternates repo\"\n    color: orange\n    rank: 2\n    order: 4\n    group: subs\n\n  - id: manifest\n    label: \"internal/manifest\\nloader · merger · validator\\ntemplate render · PastaArgs\\nMAC validation\"\n    color: yellow\n    rank: 3\n    order: 1\n    group: subs\n  - id: state\n    label: \"internal/state\\natomic state.json (0600)\\nFileRecord.Scope\\nSecretSourcePaths\"\n    color: indigo\n    rank: 3\n    order: 2\n    group: subs\n\n  - id: pkgusers\n    label: \"pkg/users (Standalone)\\nusers.toml · pinned UIDs\\nadoption (no usermod)\\nsubid + selective rollback\\nlinger · LookupPrimaryGID\"\n    color: green\n    rank: 4\n    order: 1\n    group: public\n  - id: hashutil\n    label: \"internal/hashutil\\nSHA256Hex\"\n    color: gray\n    size: s\n    rank: 4\n    order: 2\n\nedges:\n  - {from: cmd, to: apply, label: \"runs\"}\n  - {from: cmd, to: metrics, label: \"serves\"}\n  - {from: cmd, to: config, label: \"loads\"}\n  - {from: cmd, to: quadlet, label: \"validate\", style: dashed}\n  - {from: cmd, to: manifest, label: \"validate\", style: dashed}\n  - {from: cmd, to: pkgusers, label: \"validate\", style: dashed}\n\n  - {from: metrics, to: apply, label: \"Result\"}\n  - {from: metrics, to: config, label: \"ValidateListenAddr\"}\n  - {from: apply, to: config}\n  - {from: apply, to: gitops}\n  - {from: apply, to: manifest}\n  - {from: apply, to: quadlet}\n  - {from: apply, to: secrets}\n  - {from: apply, to: netmgr}\n  - {from: apply, to: state}\n  - {from: apply, to: pkgusers}\n  - {from: apply, to: hashutil, style: dashed}\n\n  - {from: gitops, to: config}\n  - {from: quadlet, to: manifest}\n  - {from: quadlet, to: hashutil, style: dashed}\n  - {from: netmgr, to: manifest, label: \"MAC / host\"}\n  - {from: netmgr, to: state, label: \"ManagedNetworkRecord\"}\n  - {from: manifest, to: pkgusers, label: \"Registry\"}\n  - {from: manifest, to: hashutil, style: dashed}\n\ngroups:\n  - {id: core, label: \"Orchestration, Config \u0026 Metrics\"}\n  - {id: subs, label: \"Internal Reconciler Subsystems\"}\n  - {id: public, label: \"Public (Zero internal/)\"}\n"
  },
