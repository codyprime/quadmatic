{
  "type": "littleboxes",
  "version": 1,
  "source": "littleboxes",
  "name": "quadmatic — 8-Stage Transactional Reconcile & Rollback Pipeline",
  "diagram": {
    "spec": {
      "title": "quadmatic — 8-Stage Transactional Reconcile \u0026 Rollback Pipeline",
      "direction": "down",
      "style": {
        "font": "sans",
        "look": "clean",
        "route": "elbow",
        "spacing": "compact",
        "compactness": 0.7,
        "theme": "gruvbox-dark"
      },
      "nodes": [
        {
          "id": "lock",
          "label": "0. Lock Acquisition\nLOCK_EX (daemon/apply) · LOCK_SH (remote dry-run)\nbounded timeout on state.json.lock",
          "color": "gray",
          "width": 330,
          "rank": 0
        },
        {
          "id": "s1",
          "label": "1. Fetch \u0026 Verify (internal/gitops)\nSSH pull · verify-commit (allowed-signers) · FF guard\ndry-run: temp bare repo + alternates",
          "color": "orange",
          "width": 330,
          "rank": 1,
          "group": "preflight"
        },
        {
          "id": "s23",
          "label": "2-3. Load, Validate \u0026 Dry-Run Render\nusers.toml · hosts/\u003ch\u003e.toml · component.toml\ncollisions · containment · in-memory age · quadlet --dryrun",
          "color": "yellow",
          "width": 330,
          "rank": 2,
          "group": "preflight"
        },
        {
          "id": "s4",
          "label": "4. Plan, Drift \u0026 Unit Health\ndisk + NM + ip rule drift · UnitState health\nformatPlanSummary (paths, secrets, units)",
          "color": "cyan",
          "width": 330,
          "rank": 3,
          "group": "preflight"
        },
        {
          "id": "dryexit",
          "label": "--dry-run / No-Op Exit\nprints plan · updates metrics\nzero host mutations",
          "shape": "ellipse",
          "color": "gray",
          "width": 230,
          "rank": 4,
          "order": 2
        },
        {
          "id": "s5",
          "label": "5. Users (pkg/users — non-destructive)\nuseradd / adopt · linger-before-subid · primary GID\natomic subid + selective per-user migrate rollback",
          "color": "green",
          "width": 330,
          "rank": 4,
          "order": 1,
          "group": "mutate"
        },
        {
          "id": "s6",
          "label": "6. Pre-Apply Rollback Snapshot\nfiles snapshot (prev + desired)\nnetmgr.Snapshot (owned + desired + ActiveProfiles)",
          "color": "blue",
          "width": 330,
          "rank": 5,
          "group": "mutate"
        },
        {
          "id": "s7a",
          "label": "7a. Networks (internal/netmgr)\nVLAN · VRF + unreachable default · macvlan DHCP\nl3mdev-before-local · post-DHCP re-render \u0026 validate",
          "color": "cyan",
          "width": 330,
          "rank": 6,
          "group": "stage7"
        },
        {
          "id": "s7bc",
          "label": "7b-7c. Files \u0026 Secrets\nos.Root atomic writes (quadlets + data)\nstdin-only podman secret create --replace",
          "color": "teal",
          "width": 330,
          "rank": 7,
          "group": "stage7"
        },
        {
          "id": "s7d",
          "label": "7d. Prune, Reload \u0026 Verify\nstop removed (exit 5 ok) · prune owned · daemon-reload\nstart/restart changed · verify UnitState",
          "color": "indigo",
          "width": 330,
          "rank": 8,
          "group": "stage7"
        },
        {
          "id": "rollback",
          "label": "Transactional Rollback (detached ctx)\n1. stop added \u0026 prior-inactive restarted units\n2. restore file snapshot · delete added files\n3. netmgr.Restore (profiles + active states)\n4. re-decrypt prior secrets via SecretSourcePaths\n5. daemon-reload + restart active restored units",
          "color": "red",
          "width": 310,
          "rank": 7,
          "order": 2
        },
        {
          "id": "s8",
          "label": "8. Commit State \u0026 Metrics\natomic state.json (SHA, hashes, Scope, SecretSourcePaths)\nupdate Prometheus gauges \u0026 counters",
          "color": "green",
          "width": 330,
          "rank": 9
        }
      ],
      "edges": [
        {
          "from": "lock",
          "to": "s1"
        },
        {
          "from": "s1",
          "to": "s23"
        },
        {
          "from": "s23",
          "to": "s4"
        },
        {
          "from": "s4",
          "to": "dryexit",
          "label": "dry-run / clean",
          "style": "dashed",
          "exit": "left",
          "enter": "top"
        },
        {
          "from": "s4",
          "to": "s5",
          "label": "changes needed"
        },
        {
          "from": "s5",
          "to": "s6"
        },
        {
          "from": "s6",
          "to": "s7a"
        },
        {
          "from": "s7a",
          "to": "s7bc"
        },
        {
          "from": "s7bc",
          "to": "s7d"
        },
        {
          "from": "s7d",
          "to": "s8",
          "label": "all verified"
        },
        {
          "from": "s7a",
          "to": "rollback",
          "label": "on error",
          "style": "dashed",
          "exit": "right",
          "enter": "top",
          "color": "red"
        },
        {
          "from": "s7bc",
          "to": "rollback",
          "label": "on error",
          "style": "dashed",
          "exit": "right",
          "enter": "top",
          "color": "red"
        },
        {
          "from": "s7d",
          "to": "rollback",
          "label": "error / SIGTERM",
          "style": "dashed",
          "exit": "right",
          "enter": "top",
          "color": "red"
        },
        {
          "from": "rollback",
          "to": "s8",
          "label": "keep prev SHA",
          "style": "dashed",
          "exit": "bottom",
          "enter": "right",
          "color": "red"
        }
      ],
      "groups": [
        {
          "id": "preflight",
          "label": "Pre-Flight Validation (Zero Host Mutations)"
        },
        {
          "id": "mutate",
          "label": "Host Reconciliation"
        },
        {
          "id": "stage7",
          "label": "Stage 7: Transactional Mutation Window",
          "group": "mutate"
        }
      ]
    },
    "version": 1,
    "source": "title: \"quadmatic — 8-Stage Transactional Reconcile \u0026 Rollback Pipeline\"\ndirection: down\nstyle:\n  theme: gruvbox-dark\n  look: clean\n  font: sans\n  route: elbow\n  spacing: compact\n  compactness: 0.7\n\nnodes:\n  - id: lock\n    label: \"0. Lock Acquisition\\nLOCK_EX (daemon/apply) · LOCK_SH (remote dry-run)\\nbounded timeout on state.json.lock\"\n    color: gray\n    width: 330\n    rank: 0\n  - id: s1\n    label: \"1. Fetch \u0026 Verify (internal/gitops)\\nSSH pull · verify-commit (allowed-signers) · FF guard\\ndry-run: temp bare repo + alternates\"\n    color: orange\n    width: 330\n    rank: 1\n    group: preflight\n  - id: s23\n    label: \"2-3. Load, Validate \u0026 Dry-Run Render\\nusers.toml · hosts/\u003ch\u003e.toml · component.toml\\ncollisions · containment · in-memory age · quadlet --dryrun\"\n    color: yellow\n    width: 330\n    rank: 2\n    group: preflight\n  - id: s4\n    label: \"4. Plan, Drift \u0026 Unit Health\\ndisk + NM + ip rule drift · UnitState health\\nformatPlanSummary (paths, secrets, units)\"\n    color: cyan\n    width: 330\n    rank: 3\n    group: preflight\n  - id: dryexit\n    label: \"--dry-run / No-Op Exit\\nprints plan · updates metrics\\nzero host mutations\"\n    shape: ellipse\n    color: gray\n    width: 230\n    rank: 4\n    order: 2\n  - id: s5\n    label: \"5. Users (pkg/users — non-destructive)\\nuseradd / adopt · linger-before-subid · primary GID\\natomic subid + selective per-user migrate rollback\"\n    color: green\n    width: 330\n    rank: 4\n    order: 1\n    group: mutate\n  - id: s6\n    label: \"6. Pre-Apply Rollback Snapshot\\nfiles snapshot (prev + desired)\\nnetmgr.Snapshot (owned + desired + ActiveProfiles)\"\n    color: blue\n    width: 330\n    rank: 5\n    group: mutate\n  - id: s7a\n    label: \"7a. Networks (internal/netmgr)\\nVLAN · VRF + unreachable default · macvlan DHCP\\nl3mdev-before-local · post-DHCP re-render \u0026 validate\"\n    color: cyan\n    width: 330\n    rank: 6\n    group: stage7\n  - id: s7bc\n    label: \"7b-7c. Files \u0026 Secrets\\nos.Root atomic writes (quadlets + data)\\nstdin-only podman secret create --replace\"\n    color: teal\n    width: 330\n    rank: 7\n    group: stage7\n  - id: s7d\n    label: \"7d. Prune, Reload \u0026 Verify\\nstop removed (exit 5 ok) · prune owned · daemon-reload\\nstart/restart changed · verify UnitState\"\n    color: indigo\n    width: 330\n    rank: 8\n    group: stage7\n  - id: rollback\n    label: \"Transactional Rollback (detached ctx)\\n1. stop added \u0026 prior-inactive restarted units\\n2. restore file snapshot · delete added files\\n3. netmgr.Restore (profiles + active states)\\n4. re-decrypt prior secrets via SecretSourcePaths\\n5. daemon-reload + restart active restored units\"\n    color: red\n    width: 310\n    rank: 7\n    order: 2\n  - id: s8\n    label: \"8. Commit State \u0026 Metrics\\natomic state.json (SHA, hashes, Scope, SecretSourcePaths)\\nupdate Prometheus gauges \u0026 counters\"\n    color: green\n    width: 330\n    rank: 9\n\nedges:\n  - {from: lock, to: s1}\n  - {from: s1, to: s23}\n  - {from: s23, to: s4}\n  - {from: s4, to: dryexit, label: \"dry-run / clean\", style: dashed, exit: left, enter: top}\n  - {from: s4, to: s5, label: \"changes needed\"}\n  - {from: s5, to: s6}\n  - {from: s6, to: s7a}\n  - {from: s7a, to: s7bc}\n  - {from: s7bc, to: s7d}\n  - {from: s7d, to: s8, label: \"all verified\"}\n  - {from: s7a, to: rollback, label: \"on error\", color: red, style: dashed, exit: right, enter: top}\n  - {from: s7bc, to: rollback, label: \"on error\", color: red, style: dashed, exit: right, enter: top}\n  - {from: s7d, to: rollback, label: \"error / SIGTERM\", color: red, style: dashed, exit: right, enter: top}\n  - {from: rollback, to: s8, label: \"keep prev SHA\", color: red, style: dashed, exit: bottom, enter: right}\n\ngroups:\n  - {id: preflight, label: \"Pre-Flight Validation (Zero Host Mutations)\"}\n  - {id: mutate, label: \"Host Reconciliation\"}\n  - {id: stage7, label: \"Stage 7: Transactional Mutation Window\", group: mutate}\n"
  },
