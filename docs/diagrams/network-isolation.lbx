{
  "type": "littleboxes",
  "version": 1,
  "source": "littleboxes",
  "name": "quadmatic — Rootless Per-Quadlet VLAN + VRF + pasta Isolation (Option 2B)",
  "diagram": {
    "spec": {
      "title": "quadmatic — Rootless Per-Quadlet VLAN + VRF + pasta Isolation (Option 2B)",
      "direction": "right",
      "style": {
        "font": "sans",
        "look": "clean",
        "route": "elbow",
        "spacing": "normal",
        "compactness": 0.45,
        "theme": "gruvbox-dark"
      },
      "nodes": [
        {
          "id": "trunk",
          "label": "Switch Trunk Port\n802.1Q Tagged VLANs\n+ Router / DHCP Server",
          "shape": "ellipse",
          "color": "orange",
          "rank": 0
        },
        {
          "id": "nic",
          "label": "Host Trunk NIC\ne.g. enp3s0\n(VLAN-agnostic host)",
          "color": "yellow",
          "rank": 1,
          "group": "host"
        },
        {
          "id": "mgmtvlan",
          "label": "Management VLAN\ne.g. enp3s0.3 (Butane)\nDefault VRF (table main)",
          "color": "blue",
          "rank": 2,
          "group": "defaultvrf"
        },
        {
          "id": "hostdaemons",
          "label": "Host Daemons\nsshd · quadmatic /metrics\npodman pull / auto-update",
          "color": "blue",
          "rank": 3,
          "group": "defaultvrf"
        },
        {
          "id": "svcvlan",
          "label": "Service VLAN\nqm-vlan\u003cV\u003e (IP-less)\nor reused unmanaged parent",
          "color": "cyan",
          "rank": 2,
          "group": "vrf"
        },
        {
          "id": "macvlan",
          "label": "macvlan qm-\u003cuid\u003e\nmode: private · pinned MAC\nDHCP static IP · ignore-auto-dns",
          "color": "teal",
          "rank": 3,
          "group": "vrf"
        },
        {
          "id": "vrfdev",
          "label": "VRF qmv-\u003cuid\u003e\ntable 10000+\u003cuid\u003e\nunreachable default metric 8192\n(IPv4 + optional IPv6)",
          "color": "violet",
          "rank": 3,
          "group": "vrf"
        },
        {
          "id": "iprule",
          "label": "Kernel Policy Routing\n1000: lookup [l3mdev-table]\n32765: lookup local\n32766: lookup main\ntcp/udp_l3mdev_accept = 0",
          "shape": "rect",
          "color": "red",
          "fill": "hachure",
          "width": 280,
          "rank": 4,
          "group": "host"
        },
        {
          "id": "pasta",
          "label": "pasta (unprivileged UID)\n--no-map-gw · --map-host-loopback,none\n-i qm-\u003cuid\u003e · --outbound-if4 qm-\u003cuid\u003e\n-t %qm-\u003cuid\u003e/\u003cports\u003e",
          "color": "green",
          "rank": 4,
          "group": "container"
        },
        {
          "id": "workload",
          "label": "Rootless Container\nisolated userns + netns\nexplicit VLAN DNS=\nno host netns access",
          "color": "green",
          "rank": 5,
          "group": "container"
        },
        {
          "id": "rootfulnet",
          "label": "Rootful Escape Hatch\nDriver=macvlan .network\n(L2 mDNS / Home Assistant)",
          "color": "orange",
          "stroke": "dashed",
          "size": "s",
          "rank": 3,
          "group": "host"
        }
      ],
      "edges": [
        {
          "from": "trunk",
          "to": "nic",
          "label": "802.1Q trunk",
          "arrow": "both"
        },
        {
          "from": "nic",
          "to": "mgmtvlan",
          "label": "VLAN 3"
        },
        {
          "from": "mgmtvlan",
          "to": "hostdaemons",
          "arrow": "both"
        },
        {
          "from": "nic",
          "to": "svcvlan",
          "label": "VLAN \u003cV\u003e"
        },
        {
          "from": "svcvlan",
          "to": "macvlan",
          "label": "parent"
        },
        {
          "from": "macvlan",
          "to": "vrfdev",
          "label": "enslaved to"
        },
        {
          "from": "vrfdev",
          "to": "iprule",
          "label": "hits rule 1000 first",
          "style": "dashed"
        },
        {
          "from": "hostdaemons",
          "to": "iprule",
          "label": "skips 1000 -\u003e local/main",
          "style": "dashed"
        },
        {
          "from": "macvlan",
          "to": "pasta",
          "label": "SO_BINDTODEVICE",
          "arrow": "both"
        },
        {
          "from": "pasta",
          "to": "workload",
          "label": "L4 tap (TCP/UDP/ICMP)",
          "arrow": "both"
        },
        {
          "from": "svcvlan",
          "to": "rootfulnet",
          "label": "ParentInterface",
          "style": "dashed"
        }
      ],
      "groups": [
        {
          "id": "host",
          "label": "Fedora CoreOS Host"
        },
        {
          "id": "defaultvrf",
          "label": "Default VRF (Management)",
          "group": "host"
        },
        {
          "id": "vrf",
          "label": "Per-Component VRF Isolation (Managed by netmgr)",
          "group": "host"
        },
        {
          "id": "container",
          "label": "Rootless Service Namespace (UID \u003cuid\u003e)",
          "group": "host"
        }
      ]
    },
    "version": 1,
    "source": "title: \"quadmatic — Rootless Per-Quadlet VLAN + VRF + pasta Isolation (Option 2B)\"\ndirection: right\nstyle:\n  theme: gruvbox-dark\n  look: clean\n  font: sans\n  route: elbow\n  spacing: normal\n  compactness: 0.45\n\nnodes:\n  # Physical network\n  - id: trunk\n    label: \"Switch Trunk Port\\n802.1Q Tagged VLANs\\n+ Router / DHCP Server\"\n    shape: ellipse\n    color: orange\n    rank: 0\n  - id: nic\n    label: \"Host Trunk NIC\\ne.g. enp3s0\\n(VLAN-agnostic host)\"\n    color: yellow\n    rank: 1\n    group: host\n\n  # Management plane (Default VRF)\n  - id: mgmtvlan\n    label: \"Management VLAN\\ne.g. enp3s0.3 (Butane)\\nDefault VRF (table main)\"\n    color: blue\n    rank: 2\n    group: defaultvrf\n  - id: hostdaemons\n    label: \"Host Daemons\\nsshd · quadmatic /metrics\\npodman pull / auto-update\"\n    color: blue\n    rank: 3\n    group: defaultvrf\n\n  # Isolated Service VLAN + VRF\n  - id: svcvlan\n    label: \"Service VLAN\\nqm-vlan\u003cV\u003e (IP-less)\\nor reused unmanaged parent\"\n    color: cyan\n    rank: 2\n    group: vrf\n  - id: macvlan\n    label: \"macvlan qm-\u003cuid\u003e\\nmode: private · pinned MAC\\nDHCP static IP · ignore-auto-dns\"\n    color: teal\n    rank: 3\n    group: vrf\n  - id: vrfdev\n    label: \"VRF qmv-\u003cuid\u003e\\ntable 10000+\u003cuid\u003e\\nunreachable default metric 8192\\n(IPv4 + optional IPv6)\"\n    color: violet\n    rank: 3\n    group: vrf\n\n  # Kernel policy routing invariant\n  - id: iprule\n    label: \"Kernel Policy Routing\\n1000: lookup [l3mdev-table]\\n32765: lookup local\\n32766: lookup main\\ntcp/udp_l3mdev_accept = 0\"\n    shape: rect\n    color: red\n    fill: hachure\n    width: 280\n    rank: 4\n    group: host\n\n  # Rootless container\n  - id: pasta\n    label: \"pasta (unprivileged UID)\\n--no-map-gw · --map-host-loopback,none\\n-i qm-\u003cuid\u003e · --outbound-if4 qm-\u003cuid\u003e\\n-t %qm-\u003cuid\u003e/\u003cports\u003e\"\n    color: green\n    rank: 4\n    group: container\n  - id: workload\n    label: \"Rootless Container\\nisolated userns + netns\\nexplicit VLAN DNS=\\nno host netns access\"\n    color: green\n    rank: 5\n    group: container\n\n  # Rootful escape hatch\n  - id: rootfulnet\n    label: \"Rootful Escape Hatch\\nDriver=macvlan .network\\n(L2 mDNS / Home Assistant)\"\n    color: orange\n    stroke: dashed\n    size: s\n    rank: 3\n    group: host\n\nedges:\n  - {from: trunk, to: nic, label: \"802.1Q trunk\", arrow: both}\n  - {from: nic, to: mgmtvlan, label: \"VLAN 3\"}\n  - {from: mgmtvlan, to: hostdaemons, arrow: both}\n  - {from: nic, to: svcvlan, label: \"VLAN \u003cV\u003e\"}\n  - {from: svcvlan, to: macvlan, label: \"parent\"}\n  - {from: macvlan, to: vrfdev, label: \"enslaved to\"}\n  - {from: vrfdev, to: iprule, label: \"hits rule 1000 first\", style: dashed}\n  - {from: hostdaemons, to: iprule, label: \"skips 1000 -\u003e local/main\", style: dashed}\n  - {from: macvlan, to: pasta, label: \"SO_BINDTODEVICE\", arrow: both}\n  - {from: pasta, to: workload, label: \"L4 tap (TCP/UDP/ICMP)\", arrow: both}\n  - {from: svcvlan, to: rootfulnet, label: \"ParentInterface\", style: dashed}\n\ngroups:\n  - {id: host, label: \"Fedora CoreOS Host\"}\n  - {id: defaultvrf, label: \"Default VRF (Management)\", group: host}\n  - {id: vrf, label: \"Per-Component VRF Isolation (Managed by netmgr)\", group: host}\n  - {id: container, label: \"Rootless Service Namespace (UID \u003cuid\u003e)\", group: host}\n"
  },
